prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: libdebayer
Description: CUDA Bayer image reconstruction
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ldebayer
Libs.private: -L@CUDAToolkit_LIBRARY_DIR@ -lcudart -lstdc++
Cflags: -I${includedir} -I${includedir}/libdebayer -I@CUDAToolkit_INCLUDE_DIRS@
